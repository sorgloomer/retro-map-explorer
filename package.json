{
  "name": "retro-map-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Explore retro game maps (Re-Volt, Carmageddon TDR 2000) in 3D from a bird's-eye view. C++ -> WebAssembly + WebGL2, no frameworks.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "build:web": "node scripts/build.mjs --web-only",
    "typecheck": "tsc -p tsconfig.json",
    "serve": "node scripts/serve.mjs 8080"
  },
  "devDependencies": {
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2"
  }
}
